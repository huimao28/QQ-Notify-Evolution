<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:label="@string/app_name"
        android:persistent="false"
        android:autoRemoveFromRecents="false"
        android:excludeFromRecents="false"
        tools:replace="android:label,android:persistent,android:autoRemoveFromRecents,android:excludeFromRecents">

        <!-- Keep only the existing listener entry point in probe mode. -->
        <service
            android:name="cc.chenhe.qqnotifyevo.service.AccessibilityMonitorService"
            android:enabled="false"
            tools:replace="android:enabled" />
        <service
            android:name=".service.NevoDecorator"
            android:enabled="false"
            tools:replace="android:enabled" />
        <service
            android:name=".service.UpgradeService"
            android:enabled="false"
            tools:replace="android:enabled" />
        <receiver
            android:name="cc.chenhe.qqnotifyevo.StaticReceiver"
            android:enabled="false"
            tools:replace="android:enabled" />
        <activity
            android:name=".ui.MainActivity"
            android:enabled="false"
            tools:replace="android:enabled" />

        <activity
            android:name="cc.chenhe.qqnotifyevo.probe.BubbleProbeActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
